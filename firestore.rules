rules_version = '2';

// Security rules for Scoop & Swirl.
// Paste this into Firebase console > Firestore Database > Rules > Publish.
// Change the admin email below if you use a different admin account
// (it must match SCOOP_ADMIN_EMAIL in firebase-config.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'icecream@gmail.com';
    }
    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Menu and hours: everyone can read, only the admin can change.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId in ['menu', 'hours'];
    }

    // Contact messages: anyone can send one, only the admin can read or delete.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'date'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
        && request.resource.data.email is string && request.resource.data.email.size() < 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() < 3000
        && request.resource.data.date == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Online orders: anyone can place one (status must start as "new").
    // Anyone with the order number can check its status; only the admin
    // can list all orders or change their status.
    match /orders/{id} {
      allow create: if request.resource.data.id == id
        && id.size() == 8
        && request.resource.data.status == 'new'
        && request.resource.data.type in ['delivery', 'pickup']
        && request.resource.data.payment in ['cash', 'card']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
        && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total < 2000
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow get: if true;
      allow list, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'preparing', 'out', 'done', 'cancelled'];
    }

    // Members: each customer manages their own card; the admin can see all.
    // Stamps can only go up by one per sign-in, to a maximum of 10.
    match /members/{uid} {
      allow read: if isAdmin() || signedIn(uid);
      allow create: if signedIn(uid) && request.resource.data.stamps == 1;
      allow update: if signedIn(uid)
        && request.resource.data.stamps is int
        && request.resource.data.stamps >= resource.data.stamps
        && request.resource.data.stamps <= resource.data.stamps + 1
        && request.resource.data.stamps <= 10;
      allow delete: if isAdmin();
    }
  }
}
